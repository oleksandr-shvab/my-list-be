# local | test | staging | production. staging and production refuse to start with a placeholder
# SECRET_KEY (under 32 characters), a non-https FRONTEND_URL or localhost CORS origins.
ENVIRONMENT=local

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/item_list
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/item_list_test
REDIS_URL=redis://localhost:6379/0
# The test suite flushes this Redis database: it must differ from REDIS_URL.
TEST_REDIS_URL=redis://localhost:6379/1

SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters

SESSION_COOKIE_NAME=session_id
SESSION_EXPIRE_MINUTES=20160

FRONTEND_URL=http://localhost:5173

BACKEND_CORS_ORIGINS=["http://localhost:5173"]
