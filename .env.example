# local | test | staging | production. staging and production refuse to start with a placeholder
# SECRET_KEY (under 32 characters), a non-https FRONTEND_URL or localhost CORS origins.
ENVIRONMENT=local

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/daily_game_challenge
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/daily_game_challenge_test
REDIS_URL=redis://localhost:6379/0
# The test suite flushes this Redis database: it must differ from REDIS_URL.
TEST_REDIS_URL=redis://localhost:6379/1

SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters

SESSION_COOKIE_NAME=session_id
SESSION_EXPIRE_MINUTES=20160

FRONTEND_URL=http://localhost:5173
# The API's own origin. Allowed to send POST, PUT, PATCH and DELETE only in local and test.
API_BASE_URL=http://localhost:8000

BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Clue media (M1-18). local: the backend serves the files itself from MEDIA_LOCAL_DIR; s3: links
# point at an S3-compatible bucket (all five S3_* values are then required).
MEDIA_STORAGE=local
# A relative folder is read from the backend repo root, not from the working directory.
MEDIA_LOCAL_DIR=var/media
# The base of local links. In dev it goes through the Vite proxy, so a link loads from the page
# with no CORS and no cookie. With local storage in production: https://<site>/api
# Only a plain path prefix is allowed: no query, fragment or credentials.
MEDIA_LOCAL_BASE_URL=http://localhost:5173/api
# Signs local links. A different secret from SECRET_KEY. staging and production with local storage
# refuse a placeholder, a key under 32 characters and a key equal to SECRET_KEY.
MEDIA_SIGNING_KEY=dev-only-media-signing-key-do-not-use-in-production
# How long a link lives, in seconds. Images and posters: 60 to 3600. Videos: 600 to 86400.
MEDIA_IMAGE_LINK_TTL_SECONDS=600
MEDIA_VIDEO_LINK_TTL_SECONDS=3600
# staging and production need an https endpoint.
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Content scripts (M1-20): the Twitch application's keys for IGDB. Only the scripts read them, never
# the server. Never commit or print them; the scripts stop before any request when one is empty.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Puzzle builder (M1-22b): the secret behind every random choice. At least 32 characters, different
# from every other secret, never committed or printed, and kept unchanged once drafts exist.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PUZZLE_SEED_SALT=
# Who may be an answer (start values; tune them with `scripts/build_puzzles.py --counts`).
# CANDIDATE_MIN_RATINGS=50
# CANDIDATE_MIN_SCREENSHOTS=7
# CANDIDATE_MIN_WIDTH=1280
# CANDIDATE_MIN_HEIGHT=720
# CANDIDATE_MIN_AGE_DAYS=365
# total_rating_count (users and critics) or aggregated_rating_count (critics only)
# CANDIDATE_RATING_FIELD=total_rating_count
