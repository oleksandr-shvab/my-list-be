{
  "permissions": {
    "allow": [
      "Bash(git merge-base *)",
      "Bash(git ls-tree *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/ruff check *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read -r f; case \"$f\" in *.py) .venv/bin/ruff format \"$f\";; esac; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
